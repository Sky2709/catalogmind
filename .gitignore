# secrets
.env
.env.local
*.pem

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# data (large / licensed - never commit)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# model caches
.cache/
models_cache/

# eval outputs (regenerated by `make eval`) - except the headline alpha-sweep
# chart, which README.md embeds directly and must exist as a real, viewable
# asset in the public repo, not just a local artifact.
eval/results/*
!eval/results/.gitkeep
!eval/results/alpha_sweep.png

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# runtime logs (redirected `make dev` output, e.g. `make dev 2>&1 | tee catalogmind.log`)
*.log

# internal working docs - AI-assistant tooling config and the live session
# journal, kept locally for continuity across sessions, not published in the
# public repo. DECISIONS.md (Day 7) is the curated, public-facing equivalent.
CLAUDE.md
PROGRESS.md
DECISIONS.md
