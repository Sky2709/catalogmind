# ---- LLM ----
# Bedrock long-term API key (bearer token) from the Bedrock console - not full AWS
# IAM credentials.
AWS_BEARER_TOKEN_BEDROCK=bedrock-api-key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=us-east-1
MODEL_REASONING=anthropic.claude-sonnet-5
MODEL_FAST=anthropic.claude-haiku-4-5

# Only used by `scripts/enrich_categories.py --provider gemini` (that script's
# default) - a scoped, one-off exception, not a provider change. See that
# script's module docstring and PROGRESS.md before using this anywhere else.
GEMINI_API_KEY=gemini-api-key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Weaviate ----
WEAVIATE_HOST=localhost
WEAVIATE_PORT=8080
WEAVIATE_GRPC_PORT=50051

# ---- Postgres ----
POSTGRES_DSN=postgresql+asyncpg://catalogmind:catalogmind@localhost:5433/catalogmind

# ---- MongoDB ----
MONGO_URI=mongodb://localhost:27017
MONGO_DB=catalogmind

# ---- Redis ----
REDIS_URL=redis://localhost:6380/0

# ---- Embeddings (local, CPU) ----
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
RERANKER_MODEL=BAAI/bge-reranker-base

# ---- Behaviour ----
DEFAULT_ALPHA=0.5
DYNAMIC_ALPHA_ENABLED=true
RERANK_ENABLED=true
RETRIEVE_TOP_K=10
RERANK_TOP_K=10
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.95

# ---- App ----
LOG_LEVEL=INFO
ENVIRONMENT=local
